<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:layout_height="match_parent"
    tools:context="com.wayyeasy.wayyeasy.Fragments.Auth.Login1">

    <TextView
        android:id="@+id/heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="User Login"
        android:gravity="center"
        android:textColor="@color/theme_color"
        android:layout_marginBottom="25dp"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.hbb20.CountryCodePicker
            android:id="@+id/ccp"
            android:background="@drawable/background_round_hollow_theme_1_4"
            android:layout_width="wrap_content"
            android:gravity="center_vertical"
            android:layout_height="match_parent"/>

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/mobile_input"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Enter mobile number"
            android:textColorHint="@color/theme_color"
            android:gravity="center"
            android:inputType="number"
            android:background="@drawable/background_round_theme_hollow_2_3"
            android:maxLength="11"
            android:layout_marginHorizontal="@dimen/_5sdp"
            android:paddingTop="15dp"
            android:paddingBottom="10dp"
            android:textSize="20sp"
            android:textColor="@color/theme_color" />
    </LinearLayout>

    <Button
        android:id="@+id/get_message"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:background="@drawable/background_solid_theme_round"
        android:text="Go"
        android:enabled="false"
        android:elevation="10dp"
        android:translationZ="2dp"
        android:stateListAnimator="@null"
        android:textColor="@color/white"/>
</LinearLayout>