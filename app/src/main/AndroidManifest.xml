<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.wayyeasy.wayyeasy">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <activity
            android:name=".Activities.CallHistoryActivity"
            android:exported="false" />

        <service
            android:name=".Services.IncomingCallService"
            android:enabled="true"
            android:exported="false" />

        <activity
            android:name=".Activities.Physicians.ViewPrescriptionActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.Physicians.PhysicianDetails"
            android:exported="false">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>
        <activity
            android:name=".Activities.Physicians.OutgoingInvitation"
            android:exported="false"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>
        <activity
            android:name=".Activities.Physicians.IncomingInvitation"
            android:exported="false"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>
        <activity
            android:name=".Activities.Physicians.BookedPhysicians"
            android:exported="false" />
        <activity
            android:name=".Activities.PathLabs.PathLabActivity"
            android:exported="false">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>
        <activity
            android:name=".Activities.Hospitals.RoomDetails"
            android:exported="false" />
        <activity
            android:name=".Activities.Privacy"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Activities.ContactUs"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Activities.Hospitals.VisitedHospitals"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Activities.UserProfile"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Activities.Dashboard"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Activities.Search.SearchActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Activities.Hospitals.HospitalActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Activities.SplashScreen"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Activities.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <service
            android:name=".Firebase.MessagingService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name=".Services.IncomingCallService"
            android:enabled="true"
            android:exported="false" />
    </application>

</manifest>